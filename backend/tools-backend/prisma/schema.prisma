generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TOOL USAGE TRACKING
// ============================================

model ToolUsage {
  id        String   @id @default(cuid())
  toolId    String
  toolName  String
  userId    String?
  sessionId String?
  input     Json?    @default("{}")
  output    Json?
  duration  Int?     @default(0)
  createdAt DateTime @default(now())

  @@index([toolId])
  @@index([userId])
  @@index([createdAt])
  @@map("tool_usages")
}
