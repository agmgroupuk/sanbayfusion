# ============================================
# Chess Player — Environment Template
# Copy to .env and fill in your API keys
# ============================================

NODE_ENV=production
PORT=3415
FRONTEND_URL=https://sanbayfusion.com
CORS_ORIGIN=https://chess-player-chat.sanbayfusion.com,https://sanbayfusion.com,https://www.sanbayfusion.com

DATABASE_URL="postgresql://USER:PASS@HOST:5432/maulaai_universal_chat?connection_limit=4"
AUTH_DATABASE_URL="postgresql://USER:PASS@HOST:5432/maulaai?connection_limit=4"

OPENAI_API_KEY=YOUR_OPENAI_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_KEY
XAI_API_KEY=YOUR_XAI_KEY
RUNWAY_API_KEY=YOUR_RUNWAY_KEY

SERPAPI_API_KEY=YOUR_KEY
OPENWEATHERMAP_API_KEY=YOUR_KEY
REPLICATE_API_TOKEN=YOUR_TOKEN

ELEVENLABS_API_KEY=YOUR_KEY
LMNT_API_KEY=YOUR_KEY

REDIS_URL="redis://HOST:PORT"
BACKEND_API_URL=http://127.0.0.1:3415
INTERNAL_API_KEY=YOUR_KEY

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET
S3_BUCKET=maula-prod-assets
AWS_S3_BUCKET=maula-prod-assets

AZURE_CONTENT_SAFETY_KEY=YOUR_KEY
AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR.cognitiveservices.azure.com/

CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
