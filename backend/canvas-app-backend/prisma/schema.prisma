// ============================================
// Canvas Studio — Standalone Prisma Schema
// Completely independent database from the main Maula AI app
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  avatar    String?
  password  String?
  provider  String?  @default("email") // email, google, github
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  apps              CanvasApp[]
  projects          CanvasProject[]
  deployCredentials CanvasDeployCredential[]
  deployHistory     CanvasDeployHistory[]
  sandboxes         Sandbox[]
  builds            Build[]
  deployments       Deployment[]
  assets            Asset[]
  databases         ProjectDatabase[]
  subscriptions     Subscription[]
  agentTasks        AgentTask[]

  @@map("users")
}

// ── Subscriptions / Plans ──────────────────────────────────────────

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  plan                 String   @default("free") // free, pro_monthly, pro_yearly
  status               String   @default("active") // active, cancelled, expired
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// ── Canvas Apps (Generated Apps) ───────────────────────────────────

model CanvasApp {
  id         String   @id @default(cuid())
  userId     String
  name       String
  prompt     String
  code       String
  language   String   @default("html")
  provider   String?
  modelId    String?
  thumbnail  String?
  history    String?  @default("[]") // JSON array of chat messages
  isFavorite Boolean  @default(false)
  isPublic   Boolean  @default(false)
  deployedUrl String?
  source     String   @default("standalone")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source])
  @@map("canvas_apps")
}

// ── Canvas Projects (Multi-file Projects) ──────────────────────────

model CanvasProject {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("Untitled Project")
  description String?
  code        String?
  thumbnail   String?
  tags        String?  @default("[]") // JSON
  metadata    String?  @default("{}") // JSON
  source      String   @default("standalone")
  version     String   @default("1.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files      ProjectFile[]
  sandboxes  Sandbox[]
  builds     Build[]
  deployments Deployment[]
  assets      Asset[]
  databases   ProjectDatabase[]
  agentTasks  AgentTask[]
  gitCommits  GitCommit[]
  gitBranches GitBranch[]
  gitStashes  GitStash[]
  gitTags     GitTag[]

  @@index([userId, createdAt])
  @@map("canvas_projects")
}

// ── Project Files ──────────────────────────────────────────────────

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String
  language  String?
  size      Int      @default(0)
  hash      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

// ── Deploy Credentials ─────────────────────────────────────────────

model CanvasDeployCredential {
  id        String   @id @default(cuid())
  userId    String
  platform  String   // vercel, netlify, railway, cloudflare
  label     String   @default("default")
  token     String   // encrypted
  teamId    String?
  source    String   @default("standalone") // standalone | embedded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, label, source])
  @@index([userId])
  @@map("canvas_deploy_credentials")
}

// ── Deploy History ─────────────────────────────────────────────────

model CanvasDeployHistory {
  id          String   @id @default(cuid())
  userId      String
  platform    String
  projectName String
  url         String?
  status      String   @default("success")
  error       String?
  source      String   @default("standalone") // standalone | embedded
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source])
  @@map("canvas_deploy_history")
}

// ── Sandboxes ──────────────────────────────────────────────────────

model Sandbox {
  id           String   @id @default(cuid())
  projectId    String
  userId       String
  containerId  String?
  status       String   @default("creating") // creating, running, stopped, destroyed, error
  template     String?
  port         Int?
  memory       Int      @default(256)
  cpu          Float    @default(0.5)
  storageUsed  Int      @default(0)
  lastActivity DateTime @default(now())
  expiresAt    DateTime?
  metadata     String?  @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("sandboxes")
}

// ── Builds ─────────────────────────────────────────────────────────

model Build {
  id           String    @id @default(cuid())
  projectId    String
  userId       String
  branch       String?   @default("main")
  commitHash   String?
  status       String    @default("queued") // queued, building, testing, success, failed, cancelled
  stages       String?   @default("[]") // JSON
  logs         String?
  duration     Int?
  artifactUrl  String?
  artifactSize Int?
  triggeredBy  String?   @default("manual")
  errorMessage String?
  metadata     String?   @default("{}")
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("builds")
}

// ── Deployments ────────────────────────────────────────────────────

model Deployment {
  id               String   @id @default(cuid())
  projectId        String
  userId           String
  buildId          String?
  environment      String   @default("preview") // preview, staging, production
  url              String?
  domain           String?
  status           String   @default("deploying") // deploying, live, rolled_back, failed, destroyed
  version          Int      @default(1)
  previousDeployId String?
  healthStatus     String?  @default("unknown")
  sizeBytes        Int?     @default(0)
  metadata         String?  @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  destroyedAt      DateTime?

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@map("deployments")
}

// ── Assets ─────────────────────────────────────────────────────────

model Asset {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  type          String   @default("file") // image, video, font, file
  originalName  String
  originalSize  Int
  optimizedSize Int?
  s3Key         String
  cdnUrl        String?
  thumbnailUrl  String?
  mimeType      String?
  width         Int?
  height        Int?
  metadata      String?  @default("{}")
  createdAt     DateTime @default(now())

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("assets")
}

// ── Project Databases ──────────────────────────────────────────────

model ProjectDatabase {
  id             String    @id @default(cuid())
  projectId      String    @unique
  userId         String
  engine         String    @default("postgres") // postgres, mysql, sqlite
  host           String?
  port           Int?      @default(5432)
  name           String?
  status         String    @default("creating") // creating, active, suspended, destroyed
  sizeBytes      Int       @default(0)
  backupSchedule String?   @default("daily")
  lastBackup     DateTime?
  connectionUrl  String?
  metadata       String?   @default("{}")
  createdAt      DateTime  @default(now())
  destroyedAt    DateTime?

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("project_databases")
}

// ── Monitoring ─────────────────────────────────────────────────────

model MonitoringError {
  id          String   @id @default(cuid())
  projectId   String
  message     String
  stack       String?
  source      String?
  count       Int      @default(1)
  resolved    Boolean  @default(false)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  metadata    String?  @default("{}")

  @@index([projectId])
  @@index([resolved])
  @@map("monitoring_errors")
}

model HealthCheck {
  id                  String   @id @default(cuid())
  projectId           String
  target              String
  type                String   @default("deployment") // sandbox, deployment, database
  healthy             Boolean  @default(true)
  latency             Int      @default(0)
  consecutiveFailures Int      @default(0)
  uptime              Float    @default(100.0)
  lastChecked         DateTime @default(now())

  @@index([projectId])
  @@map("health_checks")
}

// ── Agent Tasks ────────────────────────────────────────────────────

model AgentTask {
  id          String    @id @default(cuid())
  projectId   String
  userId      String
  intent      String    // deploy, build, rollback, debug, scale, etc.
  input       String
  plan        String?   @default("[]") // JSON array of steps
  status      String    @default("running") // running, completed, failed, cancelled
  summary     String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("agent_tasks")
}

// ── Orchestration Tasks ────────────────────────────────────────────

model OrchestrationTask {
  id         String   @id @default(cuid())
  workerId   String
  workerName String
  task       String
  status     String   @default("pending") // pending, running, completed, failed
  result     String?  // JSON
  error      String?
  duration   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@map("orchestration_tasks")
}

// ── Git Version Control ────────────────────────────────────────────

model GitCommit {
  id        String   @id @default(cuid())
  projectId String
  branch    String   @default("main")
  hash      String
  message   String
  author    String
  snapshot  String   // JSON — full file snapshot at this point
  files     String   @default("[]") // JSON — changed file paths
  stats     String?  @default("{}") // JSON — { additions, deletions }
  isMerge   Boolean  @default(false)
  createdAt DateTime @default(now())

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, branch])
  @@index([projectId, createdAt])
  @@map("git_commits")
}

model GitBranch {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  headCommitId String?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("git_branches")
}

model GitStash {
  id        String   @id @default(cuid())
  projectId String
  message   String?
  snapshot  String   // JSON — stashed file state
  branch    String   @default("main")
  createdAt DateTime @default(now())

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("git_stashes")
}

model GitTag {
  id        String   @id @default(cuid())
  projectId String
  name      String
  commitId  String
  message   String?
  createdAt DateTime @default(now())

  project CanvasProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("git_tags")
}

// ── Agent Memory ───────────────────────────────────────────────────

model AgentMemory {
  id            String   @id @default(cuid())
  userId        String
  agentId       String
  memories      Json     @default("[]")
  summary       String?
  totalMemories Int      @default(0)
  lastAccessed  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, userId])
  @@index([userId])
  @@map("agent_memories")
}

// ── User History (per-feature persisted UI history — replaces localStorage) ──
// kind values: "video" | "voice" | "image_to_code"
model UserHistory {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  data      Json
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@map("user_history")
}
