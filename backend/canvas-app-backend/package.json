{
    "name": "canvas-app-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Standalone backend for Canvas App (GenCraft Pro) — AI app builder",
    "scripts": {
        "dev": "node --watch server.js",
        "start": "node server.js",
        "db:generate": "npx prisma generate",
        "db:push": "npx prisma db push",
        "db:migrate": "npx prisma migrate dev",
        "db:studio": "npx prisma studio",
        "db:seed": "node prisma/seed.js",
        "setup": "npm install && npx prisma generate && npx prisma db push"
    },
    "dependencies": {
        "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
        "@aws-sdk/client-ec2": "^3.700.0",
        "@aws-sdk/client-ecs": "^3.700.0",
        "@aws-sdk/client-elastic-load-balancing-v2": "^3.700.0",
        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/s3-request-presigner": "^3.1131.0",
        "@prisma/client": "^6.2.1",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "express-validator": "^7.2.0",
        "helmet": "^8.0.0",
        "ioredis": "^5.4.2",
        "jsdom": "^25.0.0",
        "multer": "^1.4.5-lts.1",
        "openai": "^4.77.0",
        "stripe": "^17.5.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "prisma": "^6.2.1"
    }
}
