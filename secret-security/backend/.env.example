# Maula Device Security Backend — Environment Variables
# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (separate 'security_system' database on same RDS)
DATABASE_URL="postgresql://USERNAME:PASSWORD@YOUR_RDS_HOST:5432/security_system"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3450
NODE_ENV=production
# App base URL (for email links and download URLs)
APP_URL="https://maula.ai"
# CORS allowed origins (comma-separated) — add your admin panel domain
CORS_ORIGINS="https://security.maula.ai,https://maula.ai"

# ── Admin Auth (JWT) ──────────────────────────────────────────────────────────
# At least 64 random chars — run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX"

# ── AWS S3 (device photos + report ZIPs) ─────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
# S3 bucket — must have SSE-S3 (AES-256) enabled by default
S3_BUCKET="maula-security-data"

# ── Stripe (report download payment) ─────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
# Webhook secret from Stripe Dashboard → Webhooks → Your endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="security@maula.ai"
SMTP_PASS="YOUR_APP_PASSWORD"
SMTP_FROM="Maula Security <security@maula.ai>"
# Internal team alert address
ADMIN_ALERT_EMAIL="team@maula.ai"
