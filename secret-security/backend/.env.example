# Maula Device Security Backend — Environment Variables
# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (separate 'security_system' database on same RDS)
DATABASE_URL="postgresql://USERNAME:PASSWORD@YOUR_RDS_HOST:5432/security_system"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3450
NODE_ENV=production
# App base URL (for email links and download URLs)
APP_URL="https://sanbayfusion.com"
# CORS allowed origins (comma-separated) — add your admin panel domain
CORS_ORIGINS="https://security.sanbayfusion.com,https://sanbayfusion.com"

# ── Admin Auth (JWT) ──────────────────────────────────────────────────────────
# At least 64 random chars — run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ADMIN_JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="security@sanbayfusion.com"
SMTP_PASS="YOUR_APP_PASSWORD"
SMTP_FROM="Maula Security <security@sanbayfusion.com>"
# Internal team alert address
ADMIN_ALERT_EMAIL="team@sanbayfusion.com"
